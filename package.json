{
  "name": "codex-session-insert",
  "displayName": "Codex Session Insert",
  "description": "Insert [@file] or [@file#line-line] references into Codex with one shortcut",
  "publisher": "eyderoe",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eyderoe/Codex-SessionInsert"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexSessionInsert.insert"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codex Session Insert",
      "properties": {
        "codexSessionInsert.copyToClipboard": {
          "type": "boolean",
          "default": false,
          "description": "插入 Codex 时是否同时复制引用到剪贴板"
        },
        "codexSessionInsert.multiFileStyle": {
          "type": "string",
          "enum": [
            "comma",
            "separate"
          ],
          "enumDescriptions": [
            "[@file1, @file2]",
            "[@file1][@file2]"
          ],
          "default": "comma",
          "description": "多选文件引用样式"
        }
      }
    },
    "commands": [
      {
        "command": "codexSessionInsert.insert",
        "title": "插入Codex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexSessionInsert.insert",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste"
        }
      ],
      "explorer/context": [
        {
          "command": "codexSessionInsert.insert",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste",
          "multiSelect": true
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  }
}
